# ===========================
# LIHC Platform Configuration
# ===========================
# Copy this file to .env and update with your values

# ==================== Application Settings ====================
# Environment: development, staging, production
APP_ENV=development

# Debug mode (true/false)
APP_DEBUG=false

# Secret key for session encryption (generate a strong random key)
SECRET_KEY=your-secret-key-here-change-this-in-production

# Application name
APP_NAME="LIHC Analysis Platform"

# Application version
APP_VERSION=2.6

# ==================== Server Configuration ====================
# Host address (0.0.0.0 for all interfaces)
HOST=0.0.0.0

# Port number
PORT=8050

# Number of worker processes (recommended: number of CPU cores)
WORKERS=4

# Request timeout in seconds
REQUEST_TIMEOUT=300

# ==================== Database Configuration ====================
# Database URL (PostgreSQL/MySQL/SQLite)
# PostgreSQL: postgresql://user:password@localhost:5432/lihc_db
# MySQL: mysql://user:password@localhost:3306/lihc_db
# SQLite: sqlite:///data/lihc.db
DATABASE_URL=sqlite:///data/lihc.db

# Database connection pool settings
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30

# ==================== Redis Configuration (Optional) ====================
# Redis URL for caching and session storage
REDIS_URL=redis://localhost:6379/0

# Cache TTL in seconds (default: 1 hour)
CACHE_TTL=3600

# Enable Redis cache (true/false)
CACHE_ENABLED=true

# ==================== Data Storage ====================
# Data directory path
DATA_DIR=./data

# Results directory path
RESULTS_DIR=./results

# Temporary files directory
TEMP_DIR=./temp

# Maximum upload file size (in MB)
MAX_UPLOAD_SIZE=100

# Allowed file extensions (comma-separated)
ALLOWED_EXTENSIONS=csv,tsv,txt,xlsx,xls,h5,h5ad

# ==================== Analysis Configuration ====================
# Number of parallel workers for analysis
PARALLEL_WORKERS=4

# Analysis timeout in seconds (default: 1 hour)
ANALYSIS_TIMEOUT=3600

# Enable GPU acceleration (true/false)
GPU_ENABLED=false

# GPU device ID (if multiple GPUs)
GPU_DEVICE_ID=0

# Memory limit for analysis (in GB)
MEMORY_LIMIT=8

# ==================== Logging Configuration ====================
# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Log file path
LOG_FILE=./logs/app.log

# Maximum log file size (in MB)
LOG_MAX_SIZE=10

# Number of backup log files to keep
LOG_BACKUP_COUNT=5

# Enable console logging (true/false)
LOG_TO_CONSOLE=true

# ==================== Security Configuration ====================
# CORS allowed origins (comma-separated, * for all)
CORS_ORIGINS=*

# CORS allowed methods
CORS_METHODS=GET,POST,PUT,DELETE,OPTIONS

# Rate limiting (requests per hour)
RATE_LIMIT=100

# Session timeout in seconds (default: 1 hour)
SESSION_TIMEOUT=3600

# JWT token expiration (in hours)
JWT_EXPIRATION=24

# Enable HTTPS redirect (true/false)
FORCE_HTTPS=false

# ==================== Email Configuration (Optional) ====================
# SMTP server settings for notifications
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_USE_TLS=true

# Email sender information
EMAIL_FROM=noreply@lihc-platform.com
EMAIL_FROM_NAME="LIHC Platform"

# Admin email for error notifications
ADMIN_EMAIL=admin@lihc-platform.com

# ==================== External Services (Optional) ====================
# OpenAI API key for AI features
OPENAI_API_KEY=

# AWS S3 for cloud storage
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
AWS_REGION=us-east-1

# Google Cloud Storage
GCS_PROJECT_ID=
GCS_BUCKET=
GCS_CREDENTIALS_PATH=

# ==================== Monitoring (Optional) ====================
# Sentry DSN for error tracking
SENTRY_DSN=

# Prometheus metrics endpoint
METRICS_ENABLED=false
METRICS_PORT=9090

# DataDog API key
DATADOG_API_KEY=

# ==================== Feature Flags ====================
# Enable/disable specific features
FEATURE_AI_ANALYSIS=true
FEATURE_NETWORK_ANALYSIS=true
FEATURE_SURVIVAL_ANALYSIS=true
FEATURE_DIMENSION_ANALYSIS=true
FEATURE_LINCHPIN_TARGET=true
FEATURE_SINGLE_CELL=false
FEATURE_SPATIAL_OMICS=false

# ==================== UI Configuration ====================
# UI theme: light, dark, auto
UI_THEME=light

# UI language: en, zh
UI_LANGUAGE=zh

# Show demo data (true/false)
SHOW_DEMO_DATA=true

# Enable animations (true/false)
ENABLE_ANIMATIONS=true

# ==================== Development Settings ====================
# Hot reload (development only)
HOT_RELOAD=false

# Show SQL queries (development only)
SHOW_SQL_QUERIES=false

# Profile requests (development only)
PROFILE_REQUESTS=false

# Mock external services (development only)
MOCK_EXTERNAL_SERVICES=false